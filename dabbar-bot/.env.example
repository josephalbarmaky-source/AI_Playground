# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Ollama endpoint (default: local)
OLLAMA_HOST=http://ollama:11434

# Primary model for conversation + tool calling
OLLAMA_MODEL_MAIN=llama3.1:8b

# Fast model for classification / quick tasks
OLLAMA_MODEL_FAST=qwen2.5:3b

# Data directory for per-user SQLite databases
DABBAR_DATA_DIR=/data

# Default timezone for reminders
DABBAR_TIMEZONE=Asia/Dubai

# Admin Telegram user ID (for /admin commands)
DABBAR_ADMIN_ID=
