# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=

# Ollama endpoint (default: local)
OLLAMA_HOST=http://ollama:11434

# Primary model for conversation + tool calling
OLLAMA_MODEL_MAIN=llama3.1:8b

# Fast model for classification / quick tasks
OLLAMA_MODEL_FAST=qwen2.5:3b

# Data directory for per-user SQLite databases
DABBAR_DATA_DIR=/data

# Default timezone for reminders
DABBAR_TIMEZONE=Asia/Dubai

# Admin Telegram user ID (for /admin commands)
DABBAR_ADMIN_ID=

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8443/oauth/callback
OAUTH_SERVER_PORT=8443

# Telegram Stars payment
DABBAR_STARS_AMOUNT=10000
DABBAR_FREE_TRIAL_DAYS=7

# Whisper transcription service
WHISPER_URL=http://whisper:9000
